# ============================================================
# CONTOH ENV — WAJIB disalin ke .env lalu diisi nilai aslinya
#   cp .env.example .env
#   php artisan key:generate   (atau isi APP_KEY manual)
# JANGAN pernah commit file .env (sudah di-gitignore).
# ============================================================

APP_NAME="Portal Gereja"

# PRODUCTION: APP_ENV=production, APP_DEBUG=false
APP_ENV=production
# WAJIB DIISI — generate dengan `php artisan key:generate`.
# Jangan dibiarkan kosong; app tidak akan boot tanpa APP_KEY.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Sesuaikan dengan docker-compose.yml (mysql, host = nama service db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portal_gereja
DB_USERNAME=church_user
# WAJIB DIISI — password DB (rotasi: jangan pakai nilai lama yang sudah ter-expose)
DB_PASSWORD=
# WAJIB DIISI — password root MariaDB (hanya dipakai container db)
MARIADB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true jika akses via HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@portal-gereja.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
